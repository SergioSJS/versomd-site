# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# No inline script or style anywhere in the build, so the policy needs no
# 'unsafe-inline'. Two scripts, both files on this origin: /waitlist.js, which
# talks only to /api/waitlist, and the recordings' tabs, which Astro bundles
# into /_astro/ (astro.config.mjs keeps it from being inlined).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=86400

# The UniVerso installer script, a copy of packaging/server/universo.sh in
# the Verso repository (the source). Served as text, so a browser shows it
# to be read and nothing runs it.
/universo.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# The wiki's plain-text twins, for people and AI assistants: UTF-8 declared,
# so Portuguese reads right wherever it is fetched.
/*.md
  Content-Type: text/markdown; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/en/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/wiki-assets/*
  Cache-Control: public, max-age=86400
