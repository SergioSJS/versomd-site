---
import Base from "../../../layouts/Base.astro";
import WikiPage from "../../../components/WikiPage.astro";
import { copies } from "../../../i18n";
import { wikiText } from "../../../i18n/wiki";
import { wikiPages, pagePath } from "../../../lib/wiki";

export async function getStaticPaths() {
  const pages = await wikiPages("en");
  return pages.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, pages } }));
}
const { entry, pages } = Astro.props;
const copy = copies["en"];
const t = wikiText.en;
---

<Base copy={copy} title={`${entry.data.title} · ${t.title}`} description={entry.data.description} path={pagePath("en", entry.data.slug)} altPath={t.otherBase + entry.data.twin + "/"} current="wiki" skipTo="wiki-article" long>
  <WikiPage lang="en" pages={pages} entry={entry} />
</Base>
