---
import Base from "../layouts/Base.astro";
import DownloadPage from "../components/DownloadPage.astro";
import { copies } from "../i18n";
import { loadReleases } from "../lib/releases";

const copy = copies["pt-BR"];
const releases = await loadReleases();
---

<Base copy={copy} title={copy.pages.download.meta.title} description={copy.pages.download.meta.description} path="/baixar/" altPath="/en/download/" current="download" long>
  <DownloadPage copy={copy} releases={releases} />
</Base>
