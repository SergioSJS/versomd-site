---
import Base from "../layouts/Base.astro";
import Note from "../components/Note.astro";
import { copies } from "../i18n";

const copy = copies["pt-BR"];
---

<Base copy={copy} title={copy.thanks.metaTitle} description={copy.meta.description} path="/obrigado/" altPath="/en/thanks/" noindex>
  <Note copy={copy} kind="thanks" />
</Base>
