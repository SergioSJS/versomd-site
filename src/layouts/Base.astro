---
import "../styles/tokens.css";
import "../styles/site.css";
import type { Copy } from "../i18n";

interface Props {
  copy: Copy;
  title: string;
  description: string;
  /** This page's path, and the same page in the other language. */
  path: string;
  altPath: string;
  noindex?: boolean;
  /** Which page of the header's navigation this is, marked as current. */
  current?: Page;
  /** A long page: a "back to top" control at its end, which the script
   *  below keeps in the corner once the reader has scrolled down. */
  long?: boolean;
  /** Where the skip link lands, when not the start of <main> (a wiki page:
   *  its article, past the topics). */
  skipTo?: string;
}

type Page = "home" | "features" | "server" | "compare" | "wiki" | "download";

const { copy, title, description, path, altPath, noindex = false, current, long = false, skipTo } = Astro.props;
const site = Astro.site ?? new URL("https://versomd.com");
const canonical = new URL(path, site).href;
const alternate = new URL(altPath, site).href;
const ptHref = copy.lang === "pt-BR" ? canonical : alternate;
const enHref = copy.lang === "en" ? canonical : alternate;
const ogImage = new URL(copy.lang === "en" ? "/brand/og-verso-en.png" : "/brand/og-verso.png", site).href;
const home = copy.routes.home;
const pages: { id: Page; href: string; label: string }[] = [
  { id: "home", href: home, label: copy.nav.home },
  { id: "features", href: copy.routes.features, label: copy.nav.features },
  { id: "server", href: copy.routes.server, label: copy.nav.server },
  { id: "compare", href: copy.routes.compare, label: copy.nav.compare },
  { id: "wiki", href: copy.routes.wiki, label: copy.nav.wiki },
];
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/theme.js"></script>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf6ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#221d18" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={ptHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={ptHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/literata-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Verso" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.og.imageAlt} />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body
    data-link-label={copy.sectionLink.label}
    data-link-copied={copy.sectionLink.copied}
    data-theme-label={copy.theme.label}
    data-theme-auto={copy.theme.auto}
    data-theme-light={copy.theme.light}
    data-theme-dark={copy.theme.dark}
  >
    <a class="skip" href={`#${skipTo ?? copy.ids.content}`}>{copy.skip}</a>
    <header class="masthead" id="top">
      <a class="wordmark" href={home} aria-label="Verso">
        <img class="mark" src="/brand/verso-mark-crop.svg" width="31" height="27" alt="" />
        <span>Verso</span>
      </a>
      <nav class="sections" aria-label={copy.nav.label}>
        <ul>
          {
            pages.map((p) => (
              <li>
                <a href={p.href} aria-current={p.id === current ? "page" : undefined}>{p.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="mast-cta" href={copy.routes.download} aria-current={current === "download" ? "page" : undefined}>{copy.nav.download}</a>
      <button class="theme-cycle" type="button" data-theme-cycle hidden>
        <svg class="ti ti-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16z" class="ti-fill" /></svg>
        <svg class="ti ti-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></svg>
        <svg class="ti ti-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
      </button>
      <a class="lang" href={altPath} hreflang={copy.switchTo.hreflang} lang={copy.switchTo.hreflang} aria-label={copy.switchTo.label}>
        {copy.switchTo.name}
      </a>
    </header>

    <main id={copy.ids.content} tabindex="-1">
      <slot />
      {
        long && (
          <p class="to-top-wrap">
            <a class="to-top" href="#top" data-to-top>
              <span class="to-top-arrow" aria-hidden="true">↑</span>
              <span class="to-top-text">{copy.toTop}</span>
            </a>
          </p>
        )
      }
    </main>

    <footer class="colophon">
      <img class="colophon-mark" src="/brand/verso-mark-crop.svg" width="26" height="23" alt="" />
      <p set:html={copy.footer.lineHtml} />
      <p>{copy.footer.noTracking}</p>
      <p class="fonts" set:html={copy.footer.fontsHtml} />
      <p>
        <a href={altPath} hreflang={copy.switchTo.hreflang} lang={copy.switchTo.hreflang}>{copy.switchTo.label}</a>
      </p>
      <fieldset class="theme-pick" data-theme-pick hidden>
        <legend>{copy.theme.label}</legend>
        <label><input type="radio" name="theme-pick" value="auto" />{copy.theme.auto}</label>
        <label><input type="radio" name="theme-pick" value="light" />{copy.theme.light}</label>
        <label><input type="radio" name="theme-pick" value="dark" />{copy.theme.dark}</label>
      </fieldset>
    </footer>
    <script>
      // The theme: automatic (the system's), light or dark — the masthead's
      // button steps through the three, the footer's choice sets one; both
      // say the current one and are kept in step. Kept in this browser
      // (public/theme.js applies it before the page paints). Without the
      // script both stay hidden and the system's theme holds.
      type Theme = "auto" | "light" | "dark";
      const order: Theme[] = ["auto", "light", "dark"];
      const words = document.body.dataset;
      const nameOf = (t: Theme) => (t === "auto" ? words.themeAuto : t === "light" ? words.themeLight : words.themeDark) ?? t;
      const current = (): Theme => {
        const t = document.documentElement.dataset.theme;
        return t === "light" || t === "dark" ? t : "auto";
      };
      const cycle = document.querySelector<HTMLButtonElement>("[data-theme-cycle]");
      const pick = document.querySelector<HTMLFieldSetElement>("[data-theme-pick]");
      const paint = () => {
        const t = current();
        if (cycle) {
          cycle.dataset.choice = t;
          const label = `${words.themeLabel}: ${nameOf(t)}`;
          cycle.setAttribute("aria-label", label);
          cycle.title = label;
        }
        for (const r of pick?.querySelectorAll<HTMLInputElement>("input") ?? []) r.checked = r.value === t;
      };
      const set = (t: Theme) => {
        if (t === "auto") delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = t;
        try {
          if (t === "auto") localStorage.removeItem("versomd-theme");
          else localStorage.setItem("versomd-theme", t);
        } catch {
          // Storage refused: the choice lasts for this page only.
        }
        paint();
      };
      if (cycle) {
        cycle.hidden = false;
        cycle.addEventListener("click", () => set(order[(order.indexOf(current()) + 1) % order.length]));
      }
      if (pick) {
        pick.hidden = false;
        pick.addEventListener("change", (e) => {
          const v = (e.target as HTMLInputElement).value;
          if (v === "auto" || v === "light" || v === "dark") set(v);
        });
      }
      paint();

      // A heading's link to itself (SectionMark.astro, the wiki's "#"): a tap
      // copies the section's full address and says so beside the link; the
      // address bar then shows the section, as after following the link. If
      // the clipboard is refused, the link is simply followed.
      const label = document.body.dataset.linkLabel ?? "";
      const copied = document.body.dataset.linkCopied ?? "";
      for (const a of document.querySelectorAll<HTMLAnchorElement>("a[data-section-link]")) {
        if (!a.getAttribute("aria-label")) {
          a.setAttribute("aria-label", label);
          a.title = label;
        }
        a.addEventListener("click", (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || !navigator.clipboard) return;
          e.preventDefault();
          const url = new URL(a.getAttribute("href") ?? "", location.href).href;
          navigator.clipboard.writeText(url).then(
            () => {
              history.replaceState(null, "", url);
              let note = a.parentElement?.querySelector<HTMLElement>(".link-copied");
              if (!note) {
                note = document.createElement("span");
                note.className = "link-copied";
                note.setAttribute("role", "status");
                a.after(note);
              }
              note.textContent = copied;
              window.setTimeout(() => note?.remove(), 1800);
            },
            () => {
              location.hash = new URL(url).hash;
            },
          );
        });
      }

      // "Back to top" on a long page (on a short one there is no link, and
      // nothing to do). Without this script it is a plain link at the end of
      // the page; with it, the same link floats in the corner once the reader
      // is a screen and a half down, and steps aside near the top — and over
      // the footer, which on a phone it covered (the maintainer, 2026-10-31).
      // Where the page's column reaches the corner (a phone, a tablet, a
      // narrow window) the button would sit over the rows' own controls (the
      // roadmap's "+", a download's link: 2026-11-14), so there it shows only
      // while the reader scrolls up, the one moment they want it, and steps
      // aside again after a pause, unless it has the focus.
      const link = document.querySelector<HTMLAnchorElement>("[data-to-top]");
      if (link) {
        link.classList.add("is-floating");
        let queued = false;
        let footerSeen = false;
        let lastY = window.scrollY;
        let goingUp = false;
        let idle = 0;
        const column = document.querySelector<HTMLElement>("main .wrap");
        const crowded = () => {
          if (!column) return true;
          const right = column.getBoundingClientRect().right;
          // the button: 44 px wide, 16 px from the edge, and a little air
          return right > window.innerWidth - 16 - 44 - 8;
        };
        const update = () => {
          queued = false;
          const y = window.scrollY;
          if (y !== lastY) goingUp = y < lastY;
          lastY = y;
          const far = !footerSeen && y > window.innerHeight * 1.5;
          const show = far && (!crowded() || goingUp || link.matches(":focus"));
          link.classList.toggle("is-shown", show);
        };
        const footer = document.querySelector(".colophon");
        if (footer && "IntersectionObserver" in window) {
          new IntersectionObserver((entries) => {
            footerSeen = entries.some((e) => e.isIntersecting);
            update();
          }).observe(footer);
        }
        window.addEventListener(
          "scroll",
          () => {
            window.clearTimeout(idle);
            idle = window.setTimeout(() => {
              goingUp = false;
              update();
            }, 2500);
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
        window.addEventListener("resize", update, { passive: true });
        link.addEventListener("blur", update);
        update();
      }
    </script>
  </body>
</html>
