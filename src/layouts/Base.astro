---
import "../styles/tokens.css";
import "../styles/site.css";
import type { Copy } from "../i18n";

interface Props {
  copy: Copy;
  title: string;
  description: string;
  /** This page's path, and the same page in the other language. */
  path: string;
  altPath: string;
  noindex?: boolean;
  /** Which page of the header's navigation this is, marked as current. */
  current?: Page;
  /** A long page: a "back to top" control at its end, which the script
   *  below keeps in the corner once the reader has scrolled down. */
  long?: boolean;
}

type Page = "home" | "features" | "server" | "compare";

const { copy, title, description, path, altPath, noindex = false, current, long = false } = Astro.props;
const site = Astro.site ?? new URL("https://versomd.com");
const canonical = new URL(path, site).href;
const alternate = new URL(altPath, site).href;
const ptHref = copy.lang === "pt-BR" ? canonical : alternate;
const enHref = copy.lang === "en" ? canonical : alternate;
const ogImage = new URL(copy.lang === "en" ? "/brand/og-verso-en.png" : "/brand/og-verso.png", site).href;
const home = copy.routes.home;
const pages: { id: Page; href: string; label: string }[] = [
  { id: "home", href: home, label: copy.nav.home },
  { id: "features", href: copy.routes.features, label: copy.nav.features },
  { id: "server", href: copy.routes.server, label: copy.nav.server },
  { id: "compare", href: copy.routes.compare, label: copy.nav.compare },
];
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf6ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#221d18" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={ptHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={ptHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/literata-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Verso" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.og.imageAlt} />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href={`#${copy.ids.content}`}>{copy.skip}</a>
    <header class="masthead" id="top">
      <a class="wordmark" href={home} aria-label="Verso">
        <img class="mark" src="/brand/verso-mark-crop.svg" width="31" height="27" alt="" />
        <span>Verso</span>
      </a>
      <nav class="sections" aria-label={copy.nav.label}>
        <ul>
          {
            pages.map((p) => (
              <li>
                <a href={p.href} aria-current={p.id === current ? "page" : undefined}>{p.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="mast-cta" href={`${home}#${copy.ids.waitlist}`}>{copy.nav.waitlist}</a>
      <a class="lang" href={altPath} hreflang={copy.switchTo.hreflang} lang={copy.switchTo.hreflang} aria-label={copy.switchTo.label}>
        {copy.switchTo.name}
      </a>
    </header>

    <main id={copy.ids.content} tabindex="-1">
      <slot />
      {
        long && (
          <p class="to-top-wrap">
            <a class="to-top" href="#top" data-to-top>
              <span class="to-top-arrow" aria-hidden="true">↑</span>
              <span class="to-top-text">{copy.toTop}</span>
            </a>
          </p>
        )
      }
    </main>

    <footer class="colophon">
      <img class="colophon-mark" src="/brand/verso-mark-crop.svg" width="26" height="23" alt="" />
      <p set:html={copy.footer.lineHtml} />
      <p>{copy.footer.noTracking}</p>
      <p class="fonts" set:html={copy.footer.fontsHtml} />
      <p>
        <a href={altPath} hreflang={copy.switchTo.hreflang} lang={copy.switchTo.hreflang}>{copy.switchTo.label}</a>
      </p>
    </footer>
    <script>
      // "Back to top" on a long page (on a short one there is no link, and
      // nothing to do). Without this script it is a plain link at the end of
      // the page; with it, the same link floats in the corner once the reader
      // is a screen and a half down, and steps aside near the top.
      const link = document.querySelector<HTMLAnchorElement>("[data-to-top]");
      if (link) {
        link.classList.add("is-floating");
        let queued = false;
        const update = () => {
          queued = false;
          link.classList.toggle("is-shown", window.scrollY > window.innerHeight * 1.5);
        };
        window.addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
        update();
      }
    </script>
  </body>
</html>
