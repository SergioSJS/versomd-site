---
// A small drawing of where the files live in one way of using Verso, for
// "How will you use Verso?" on the home page. Drawn as the window draws:
// hairlines in ink, one seal-red dot where a whole copy of the files lives,
// brass dashes for sync, a plain line with a head for a window that only
// reaches the files. Colours come from tokens.css through the classes in
// scenarios.css (no inline style: the Content-Security-Policy refuses it).
import type { ScenarioMap } from "../i18n/types";

interface Props {
  map: ScenarioMap;
  id: string;
  title: string;
  desc: string;
  labels: string[];
}

const { map, id, title, desc, labels } = Astro.props;
const L = (i: number) => labels[i] ?? "";

type Glyph = "laptop" | "phone" | "server" | "cloud" | "browser" | "person" | "folder";
interface Item { g: Glyph; x: number; y: number; seal?: boolean }
interface Text { t: string; x: number; y: number; anchor?: "start" | "middle" | "end"; small?: boolean }
interface Link { x1: number; y1: number; x2: number; y2: number; kind: "sync" | "reach" | "plain" }

const P: Record<Glyph, string> = {
  laptop: "M-22 -18h44a2 2 0 0 1 2 2v26h-48v-26a2 2 0 0 1 2-2zM-29 10h58l-4 6h-50z",
  phone: "M-7 -19h14a4 4 0 0 1 4 4v30a4 4 0 0 1-4 4h-14a4 4 0 0 1-4-4v-30a4 4 0 0 1 4-4zM-3 13h6",
  server: "M-21 -13v26a21 6 0 0 0 42 0v-26M-21 -13a21 6 0 0 0 42 0a21 6 0 0 0-42 0M-21 0a21 6 0 0 0 42 0",
  cloud: "M-20 12h37a10 10 0 0 0 2-19.6a13 13 0 0 0-24.5-5a10 10 0 0 0-15 9a8 8 0 0 0 0.5 15.6z",
  browser: "M-21 -16h42a3 3 0 0 1 3 3v26a3 3 0 0 1-3 3h-42a3 3 0 0 1-3-3v-26a3 3 0 0 1 3-3zM-24 -7h48",
  person: "M0 -15a6 6 0 1 1 0 12a6 6 0 1 1 0-12zM-11 14a11 10 0 0 1 22 0",
  folder: "M-19 -13h12l4 5h22a2 2 0 0 1 2 2v19h-42v-24a2 2 0 0 1 2-2z",
};
// Where a glyph's seal sits, from its centre.
const SEAL: Record<Glyph, [number, number]> = {
  laptop: [20, -18], phone: [10, -19], server: [20, -16], cloud: [16, -14], browser: [20, -16], person: [9, -14], folder: [19, -10],
};

let items: Item[] = [];
let texts: Text[] = [];
let links: Link[] = [];
let zone: { x: number; y: number; w: number; h: number; label: string } | null = null;
// Each drawing's box (x y width height): one size for all, so the plates
// of a row line up, with what each holds centred in it.
const BOX: Record<ScenarioMap, string> = {
  local: "0 3 280 144", home: "0 0 280 144", cloud: "0 4 280 144",
  universo: "0 5 280 144", table: "0 12 280 144", team: "0 4 280 144",
};

switch (map) {
  case "local":
    items = [{ g: "laptop", x: 78, y: 62 }, { g: "folder", x: 200, y: 62, seal: true }];
    links = [{ x1: 112, y1: 64, x2: 172, y2: 64, kind: "plain" }];
    texts = [{ t: L(0), x: 78, y: 102 }, { t: L(1), x: 200, y: 102 }];
    break;
  case "home":
    zone = { x: 6, y: 6, w: 268, h: 132, label: L(0) };
    items = [{ g: "laptop", x: 80, y: 74, seal: true }, { g: "phone", x: 204, y: 74 }];
    links = [{ x1: 114, y1: 74, x2: 186, y2: 74, kind: "reach" }];
    texts = [{ t: L(1), x: 80, y: 114 }, { t: L(2), x: 204, y: 114 }, { t: L(3), x: 150, y: 66, small: true }];
    break;
  case "cloud":
    items = [{ g: "cloud", x: 140, y: 34, seal: true }, { g: "laptop", x: 58, y: 100, seal: true }, { g: "phone", x: 222, y: 100, seal: true }];
    links = [
      { x1: 82, y1: 80, x2: 118, y2: 50, kind: "sync" },
      { x1: 206, y1: 78, x2: 162, y2: 50, kind: "sync" },
    ];
    texts = [
      { t: L(0), x: 168, y: 30, anchor: "start" }, { t: L(1), x: 58, y: 138 }, { t: L(2), x: 222, y: 138 },
      { t: L(3), x: 140, y: 74, small: true },
    ];
    break;
  case "universo":
    items = [
      { g: "server", x: 140, y: 34, seal: true }, { g: "laptop", x: 48, y: 104, seal: true },
      { g: "phone", x: 140, y: 106, seal: true }, { g: "browser", x: 232, y: 104 },
    ];
    links = [
      { x1: 72, y1: 84, x2: 116, y2: 50, kind: "sync" },
      { x1: 140, y1: 84, x2: 140, y2: 56, kind: "sync" },
      { x1: 214, y1: 84, x2: 166, y2: 50, kind: "reach" },
    ];
    texts = [{ t: L(0), x: 170, y: 30, anchor: "start" }, { t: L(1), x: 48, y: 142 }, { t: L(2), x: 140, y: 142 }, { t: L(3), x: 232, y: 142 }];
    break;
  case "table":
    items = [
      { g: "laptop", x: 56, y: 72, seal: true },
      { g: "person", x: 214, y: 40 }, { g: "person", x: 250, y: 74 }, { g: "person", x: 214, y: 104 },
    ];
    links = [{ x1: 92, y1: 72, x2: 188, y2: 72, kind: "reach" }];
    texts = [{ t: L(0), x: 56, y: 112 }, { t: L(1), x: 140, y: 64, small: true }, { t: L(2), x: 230, y: 142 }];
    break;
  case "team":
    items = [
      { g: "server", x: 140, y: 34, seal: true }, { g: "person", x: 48, y: 104, seal: true },
      { g: "person", x: 140, y: 106, seal: true }, { g: "person", x: 232, y: 104 },
    ];
    links = [
      { x1: 66, y1: 88, x2: 116, y2: 50, kind: "sync" },
      { x1: 140, y1: 88, x2: 140, y2: 56, kind: "sync" },
      { x1: 166, y1: 50, x2: 214, y2: 86, kind: "reach" },
    ];
    texts = [{ t: L(0), x: 170, y: 30, anchor: "start" }, { t: L(1), x: 48, y: 136 }, { t: L(2), x: 140, y: 136 }, { t: L(3), x: 232, y: 136 }];
    break;
}

// A small open head at the end of a "reach" line, pointing along it.
const head = (l: Link) => {
  const a = Math.atan2(l.y2 - l.y1, l.x2 - l.x1);
  const s = 6;
  const p = (da: number) => `${(l.x2 - s * Math.cos(a + da)).toFixed(1)} ${(l.y2 - s * Math.sin(a + da)).toFixed(1)}`;
  return `M${p(0.5)}L${l.x2} ${l.y2}L${p(-0.5)}`;
};
---

<svg class="sm" viewBox={BOX[map]} role="img" aria-labelledby={`${id}-t ${id}-d`} focusable="false">
  <title id={`${id}-t`}>{title}</title>
  <desc id={`${id}-d`}>{desc}</desc>
  {
    zone && (
      <g>
        <rect class="sm-zone" x={zone.x} y={zone.y} width={zone.w} height={zone.h} rx="8" />
        <text class="sm-label sm-small" x={zone.x + 10} y={zone.y + 17}>{zone.label}</text>
      </g>
    )
  }
  {
    links.map((l) => (
      <g class={`sm-${l.kind}`}>
        <path d={`M${l.x1} ${l.y1}L${l.x2} ${l.y2}`} />
        {l.kind === "reach" && <path d={head(l)} />}
      </g>
    ))
  }
  {
    items.map((it) => (
      <g transform={`translate(${it.x} ${it.y})`}>
        <path class="sm-glyph" d={P[it.g]} />
        {it.seal && <circle class="sm-seal" cx={SEAL[it.g][0]} cy={SEAL[it.g][1]} r="4.5" />}
      </g>
    ))
  }
  {
    texts.map((t) => (
      <text class={t.small ? "sm-label sm-small" : "sm-label"} x={t.x} y={t.y} text-anchor={t.anchor ?? "middle"}>
        {t.t}
      </text>
    ))
  }
</svg>
