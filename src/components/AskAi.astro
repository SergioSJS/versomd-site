---
// "Ask an AI": a question field and buttons that open an assistant with a
// ready prompt (the documentation's link + rules + the question). Without
// JavaScript the links open with the question left blank and the prompt text
// stands in a <details> to copy by hand; the script fills the question in and
// adds "Copy prompt".
import { wikiText, AI_TARGETS, type WikiLang } from "../i18n/wiki";

interface Props {
  lang: WikiLang;
  /** The Markdown URL the assistant must read. */
  url: string;
  /** Page or index: only changes the title and the field's id. */
  scope: "index" | "page";
}

const { lang, url, scope } = Astro.props;
const t = wikiText[lang].ask;
const id = `ask-${scope}`;
const template = t.prompt(url, "{{q}}");
const blank = t.prompt(url, "");
---

<section class="ask" aria-labelledby={`${id}-h`} data-ask data-template={template} data-copied={t.copied}>
  <h2 id={`${id}-h`}>{scope === "page" ? t.pageTitle : t.title}</h2>
  <p class="ask-intro">{t.intro}</p>
  <div class="ask-field">
    <label for={`${id}-q`}>{t.label}</label>
    <textarea id={`${id}-q`} rows="2" maxlength="600" placeholder={t.placeholder} data-ask-q></textarea>
  </div>
  <ul class="ask-buttons">
    {
      AI_TARGETS.map((a) => (
        <li>
          <a class="button ask-go" href={a.url + encodeURIComponent(blank)} target="_blank" rel="noopener noreferrer" data-ask-link data-base={a.url}>
            {t.openIn(a.name)}
          </a>
        </li>
      ))
    }
    <li><button type="button" class="button ask-copy" data-ask-copy hidden>{t.copy}</button></li>
  </ul>
  <p class="ask-hint">{t.copyHint}</p>
  <p class="ask-status" role="status" aria-live="polite" data-ask-status></p>
  <details class="ask-prompt">
    <summary>{t.showPrompt}</summary>
    <pre><code data-ask-text>{blank}</code></pre>
  </details>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ask]").forEach((root) => {
    const template = root.dataset.template ?? "";
    const q = root.querySelector<HTMLTextAreaElement>("[data-ask-q]")!;
    const text = root.querySelector<HTMLElement>("[data-ask-text]")!;
    const copy = root.querySelector<HTMLButtonElement>("[data-ask-copy]")!;
    const status = root.querySelector<HTMLElement>("[data-ask-status]")!;
    const links = root.querySelectorAll<HTMLAnchorElement>("[data-ask-link]");
    const prompt = () => template.replace("{{q}}", () => q.value.trim());
    const update = () => {
      const p = prompt();
      text.textContent = p;
      links.forEach((a) => (a.href = (a.dataset.base ?? "") + encodeURIComponent(p)));
    };
    q.addEventListener("input", update);
    copy.hidden = false;
    copy.addEventListener("click", async () => {
      const p = prompt();
      try {
        await navigator.clipboard.writeText(p);
      } catch {
        // No clipboard permission: select the text so Ctrl/Cmd+C works.
        root.querySelector("details")!.open = true;
        const r = document.createRange();
        r.selectNodeContents(text);
        const s = window.getSelection();
        s?.removeAllRanges();
        s?.addRange(r);
        return;
      }
      status.textContent = root.dataset.copied ?? "";
      setTimeout(() => (status.textContent = ""), 3000);
    });
    update();
  });
</script>
