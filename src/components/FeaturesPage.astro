---
import SectionMark from "./SectionMark.astro";
// Features: what Verso does today, in the words of someone who uses it,
// then the roadmap — what comes next, one line each, with its state.
import type { Copy } from "../i18n";
import type { RoadmapState } from "../i18n/types";
import PageHead from "./PageHead.astro";
import CtaStrip from "./CtaStrip.astro";
import Figure from "./Figure.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const page = copy.pages.features;
const { files } = copy.how;
const { today, gallery, roadmap } = page;
const { ids } = copy;

// The roadmap as a rail: one stretch per state present in the data, in
// this order, each with its count; "you are here" closes the ready
// stretch, the V1 flag closes the last stretch before "later".
const order: RoadmapState[] = ["ready", "building", "planned", "later"];
const present = order.filter((state) => roadmap.groups.some((g) => g.state === state));
const lastBeforeLater = present.filter((state) => state !== "later").at(-1);
const stretches = present.map((state, i) => {
  const groups = roadmap.groups.filter((g) => g.state === state);
  const n = groups.reduce((sum, g) => sum + g.items.length, 0);
  const stops: ("here" | "v1")[] = [];
  if (state === "ready") stops.push("here");
  if (state === lastBeforeLater && present.includes("later")) stops.push("v1");
  const prev = present[i - 1];
  const afterStop = prev === "ready" || (prev === lastBeforeLater && state === "later");
  const countText = (n === 1 ? roadmap.count.one : roadmap.count.other).replace("{n}", String(n));
  return { state, groups, stops, afterStop, countText };
});
// Status by shape as well as colour; the words are in the stretch heading.
const svg = (body: string) =>
  `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">${body}</svg>`;
const glyphs: Record<RoadmapState, string> = {
  ready: svg(`<path d="M3.2 8.6 6.4 11.6 12.8 4.6"/>`),
  building: svg(`<circle cx="8" cy="8" r="4.6"/><path d="M8 3.4a4.6 4.6 0 0 1 0 9.2z" fill="currentColor" stroke="none"/>`),
  planned: svg(`<circle cx="8" cy="8" r="4.6" stroke-width="1.8"/>`),
  later: svg(`<path d="M4.6 8h6.8"/>`),
};
const flag = `<svg viewBox="0 0 18 28" width="18" height="28" focusable="false"><path d="M2.5 27V2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3.5 2.5h11.5l-3 4.25 3 4.25H3.5z" fill="currentColor"/></svg>`;
---

<article class="landing subpage features-page">
  <PageHead eyebrow={page.eyebrow} title={page.title} ledeHtml={page.ledeHtml} />

  <section class="block" aria-labelledby={ids.files}>
    <div class="wrap">
      <h2 id={ids.files}><SectionMark to={ids.files} />{files.title}</h2>
      <div class="files-text">
        {files.paragraphsHtml.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <section class="block today" aria-labelledby={ids.today}>
    <div class="wrap">
      <h2 id={ids.today}><SectionMark to={ids.today} />{today.title}</h2>
      <p class="today-intro aside" set:html={today.introHtml} />
      <div class="feature-groups">
        {
          today.groups.map((g) => (
            <div class="feature-group">
              <h3>{g.title}</h3>
              <ul>
                {g.itemsHtml.map((item) => (
                  <li set:html={item} />
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block gallery" aria-labelledby={ids.gallery}>
    <div class="wrap">
      <h2 id={ids.gallery}><SectionMark to={ids.gallery} />{gallery.title}</h2>
      <p class="today-intro aside" set:html={gallery.introHtml} />
      <div class="gallery-grid">
        {gallery.figures.map((f, i) => <Figure figure={f} label={copy.figLabel} number={i + 1} class="gallery-plate" />)}
      </div>
    </div>
  </section>

  <section class="roadmap" aria-labelledby={ids.roadmap}>
    <div class="wrap">
      <h2 id={ids.roadmap}><SectionMark to={ids.roadmap} />{roadmap.title}</h2>
      <p class="roadmap-intro" set:html={roadmap.introHtml} />
      <p class="roadmap-updated"><time datetime={roadmap.updated.dateTime}>{roadmap.updated.text}</time></p>
      <ol class="rm">
        {
          stretches.map((s) => (
            <li class:list={["rm-stretch", `is-${s.state}`, { "after-stop": s.afterStop, "has-stop": s.stops.length > 0 }]}>
              <h3 class="rm-head">
                <span class="rm-name">{roadmap.states[s.state]}</span><span class="sr">, </span>
                <span class="rm-count">{s.countText}</span>
              </h3>
              {s.groups.map((g) => (
                <>
                  {s.groups.length > 1 && g.title && <h4 class="rm-sub">{g.title}</h4>}
                  <ul class="rm-items">
                    {g.items.map((item) => (
                      <li>
                        {item.textHtml ? (
                          <details class="rm-item">
                            <summary>
                              <span class="rm-glyph" aria-hidden="true" set:html={glyphs[s.state]} />
                              <span class="rm-lead">{item.lead}</span>
                            </summary>
                            <p class="rm-more" set:html={item.textHtml} />
                          </details>
                        ) : (
                          <div class="rm-item rm-plain">
                            <span class="rm-glyph" aria-hidden="true" set:html={glyphs[s.state]} />
                            <span class="rm-lead">{item.lead}</span>
                          </div>
                        )}
                      </li>
                    ))}
                  </ul>
                </>
              ))}
              {s.stops.includes("here") && (
                <p class="rm-stop is-here">
                  <span class="rm-mark" aria-hidden="true" />
                  <span class="rm-label">{roadmap.stops.here}</span>
                </p>
              )}
              {s.stops.includes("v1") && (
                <p class="rm-stop is-v1">
                  <span class="rm-mark" aria-hidden="true" set:html={flag} />
                  <span class="rm-label"><strong>{roadmap.stops.v1}</strong> <span class="rm-note">{roadmap.stops.v1Note}</span></span>
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="wrap">
    <CtaStrip copy={copy} />
  </div>
</article>
