---
// The home page: the essentials, short. The features and the roadmap, the
// server and the comparison each have a page of their own (Base's header
// links them); the cards under "who it is for" point at them too.
import type { Copy } from "../i18n";
import Figure from "./Figure.astro";
import WaitlistForm from "./WaitlistForm.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { hero, who, more, motion, notYet, faq, waitlist, ids, routes } = copy;

// The title is two sentences; the second is set apart, as the app sets a
// note's title apart from its body.
const [first, ...rest] = hero.title.split(/(?<=\.)\s+/);
const second = rest.join(" ");

let n = 0;
const next = () => ++n;
const heroNumber = next();
const motionNumbers = motion.figures.map(() => next());

// Sections that moved to a page of their own: an old link to one of them
// (#como-funciona, #comparativo?f=…) is sent on by the script below.
const moved: Record<string, string> = copy.lang === "pt-BR"
  ? { "como-funciona": routes.server, vps: `${routes.server}#vps`, [ids.compare]: routes.compare }
  : { "how-it-works": routes.server, vps: `${routes.server}#vps`, [ids.compare]: routes.compare };
---

<article class="landing" data-moved={JSON.stringify(moved)} data-compare-id={ids.compare}>
  <!-- The fold: the words on the left, the window on the right. -->
  <header class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>
          <span class="md" aria-hidden="true">#</span>
          <span class="h1-a">{first}</span>
          {second && <span class="h1-b">{second}</span>}
        </h1>
        <p class="lede" set:html={hero.ledeHtml} />
        <p class="actions">
          <a class="button" href={`#${ids.waitlist}`}>{hero.cta}</a>
          <a class="quiet" href={`#${ids.notYet}`}>{hero.ctaSecondary}</a>
        </p>
      </div>
      <Figure figure={hero.figure} label={copy.figLabel} number={heroNumber} eager class="hero-plate" />
    </div>
  </header>

  <!-- "In short": the properties, as the app shows a note's frontmatter. -->
  <section class="facts" aria-label={hero.propsLabel}>
    <div class="wrap">
      <p class="facts-label" aria-hidden="true">{hero.propsLabel}</p>
      <dl>
        {
          hero.props.map((p) => (
            <div>
              <dt>{p.key}</dt>
              <dd set:html={p.valueHtml} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="block values" aria-labelledby="who">
    <div class="wrap">
      <h2 id="who"><span class="md" aria-hidden="true">##</span>{who.title}</h2>
      <ul class="cards">
        {
          who.items.map((item) => (
            <li class="card">
              <p class="card-kicker" aria-hidden="true">{item.kicker}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The other pages, one card each: the whole card is the link's target,
       the link itself is the last line (its words say where it goes). -->
  <section class="block more" aria-labelledby="more">
    <div class="wrap">
      <h2 id="more"><span class="md" aria-hidden="true">##</span>{more.title}</h2>
      <ul class="more-cards">
        {
          more.items.map((item) => (
            <li class="more-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a class="more-link" href={routes[item.page]}>
                {item.link}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block motion" aria-labelledby="motion">
    <div class="wrap">
      <h2 id="motion"><span class="md" aria-hidden="true">##</span>{motion.title}</h2>
      <p class="aside motion-intro">{motion.intro}</p>
      <!--
        Without JavaScript the four recordings stand one under the other and the
        tab list stays hidden. The script below shows the tabs and one panel.
      -->
      <div class="tabs" data-tabs>
        <div class="tablist" role="tablist" aria-label={motion.tabsLabel} hidden>
          {
            motion.tabs.map((label, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${i + 1}`}
                aria-controls={`panel-${i + 1}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                {label}
              </button>
            ))
          }
        </div>
        {
          motion.figures.map((f, i) => (
            <div class="panel" id={`panel-${i + 1}`} data-panel>
              <Figure figure={f} label={copy.figLabel} number={motionNumbers[i]} />
              <button type="button" class="play" aria-pressed="false" hidden>
                {motion.play}
              </button>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="not-yet" aria-labelledby={ids.notYet}>
    <div class="wrap">
      <h2 id={ids.notYet}><span class="md" aria-hidden="true">##</span>{notYet.title}</h2>
      <p class="aside">{notYet.intro}</p>
      <ul>
        {
          notYet.items.map((item) => (
            <li>
              <strong>{item.lead}</strong>
              <span set:html={item.textHtml} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block faq" aria-labelledby={ids.faq}>
    <div class="wrap">
      <h2 id={ids.faq}><span class="md" aria-hidden="true">##</span>{faq.title}</h2>
      <div class="qa-list">
        {
          faq.items.map((item) => (
            <details class="qa">
              <summary>{item.q}</summary>
              <div class="qa-a">{item.aHtml.map((p) => <p set:html={p} />)}</div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="waitlist" aria-labelledby={ids.waitlist}>
    <div class="waitlist-inner">
      <h2 id={ids.waitlist}><span class="md" aria-hidden="true">##</span>{waitlist.title}</h2>
      <p>{waitlist.intro}</p>
      <WaitlistForm copy={copy} />
    </div>
  </section>
</article>
<script is:inline src="/waitlist.js" defer></script>
<script>
  // An old link to a section that has moved to a page of its own goes
  // there (replacing this entry in the history), the comparison's view in
  // the address kept: #comparativo?f=… becomes /comparativo/#comparativo?f=….
  const article = document.querySelector<HTMLElement>("[data-moved]");
  const hash = location.hash.slice(1);
  if (article && hash) {
    let moved: Record<string, string> = {};
    try {
      moved = JSON.parse(article.dataset.moved ?? "{}");
    } catch {
      moved = {};
    }
    const key = decodeURIComponent(hash.split("?")[0]);
    const to = moved[key];
    if (to) location.replace(key === article.dataset.compareId ? `${to}#${hash}` : to);
  }
</script>
<script>
  // The recordings as tabs (WAI-ARIA tabs pattern, automatic activation):
  // one panel at a time, roving tabindex, arrows / Home / End. With reduced
  // motion the posters stay and a button plays the one in view.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const list = root.querySelector<HTMLElement>("[role=tablist]");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));
    if (!list || tabs.length === 0 || tabs.length !== panels.length) continue;

    panels.forEach((panel, i) => {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tabs[i].id);
      panel.tabIndex = 0;
    });

    const select = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i, false));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        let to = -1;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") to = i === last ? 0 : i + 1;
        else if (event.key === "ArrowLeft" || event.key === "ArrowUp") to = i === 0 ? last : i - 1;
        else if (event.key === "Home") to = 0;
        else if (event.key === "End") to = last;
        if (to < 0) return;
        event.preventDefault();
        select(to, true);
      });
    });

    list.hidden = false;
    root.classList.add("is-tabbed");
    select(0, false);

    // Reduced motion: a still until asked. "Play" turns the still source off,
    // which makes the picture choose the recording; pressing again restores it.
    const syncPlayButtons = () => {
      for (const panel of panels) {
        const button = panel.querySelector<HTMLButtonElement>(".play");
        const still = panel.querySelector<HTMLSourceElement>("source[data-still]");
        if (!button || !still) continue;
        button.hidden = !reduce.matches;
        if (!reduce.matches) {
          still.media = "(prefers-reduced-motion: reduce)";
          button.setAttribute("aria-pressed", "false");
        }
      }
    };
    for (const panel of panels) {
      const button = panel.querySelector<HTMLButtonElement>(".play");
      const still = panel.querySelector<HTMLSourceElement>("source[data-still]");
      if (!button || !still) continue;
      button.addEventListener("click", () => {
        const playing = button.getAttribute("aria-pressed") === "true";
        still.media = playing ? "(prefers-reduced-motion: reduce)" : "not all";
        button.setAttribute("aria-pressed", playing ? "false" : "true");
      });
    }
    syncPlayButtons();
    reduce.addEventListener("change", syncPlayButtons);
  }
</script>
