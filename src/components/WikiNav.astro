---
import { wikiText, type WikiLang } from "../i18n/wiki";
import { GROUP_ORDER, pagePath, type WikiEntry } from "../lib/wiki";

interface Props {
  lang: WikiLang;
  pages: WikiEntry[];
  current?: string;
}
const { lang, pages, current } = Astro.props;
const t = wikiText[lang];
---

<nav class="wiki-nav" aria-label={t.allTopics}>
  <p class="wiki-nav-title"><a href={t.base} aria-current={current === undefined ? "page" : undefined}>{t.title}</a></p>
  {
    GROUP_ORDER.map((g) => (
      <>
        <h2 class="wiki-nav-group">{t.groups[g]}</h2>
        <ul>
          {pages.filter((p) => p.data.group === g).map((p) => (
            <li><a href={pagePath(lang, p.data.slug)} aria-current={p.data.slug === current ? "page" : undefined}>{p.data.title}</a></li>
          ))}
        </ul>
      </>
    ))
  }
</nav>
